# AdApe Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# TikTok API Configuration
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
VITE_TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
VITE_TIKTOK_REDIRECT_URI=http://localhost:5173/auth/tiktok/callback

# Instagram API Configuration
VITE_INSTAGRAM_APP_ID=your_instagram_app_id_here
VITE_INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
VITE_INSTAGRAM_REDIRECT_URI=http://localhost:5173/auth/instagram/callback

# Application Configuration
VITE_APP_NAME=AdApe
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5173/api

# Development Configuration
NODE_ENV=development
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# Production Configuration (uncomment for production)
# NODE_ENV=production
# VITE_DEBUG=false
# VITE_LOG_LEVEL=error
# VITE_APP_URL=https://your-domain.com
# VITE_API_BASE_URL=https://your-domain.com/api

# Optional: Analytics and Monitoring
# VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# VITE_SENTRY_DSN=https://your-sentry-dsn
# VITE_MIXPANEL_TOKEN=your_mixpanel_token

# Optional: Payment Processing (for subscription management)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Optional: Email Service (for notifications)
# VITE_SENDGRID_API_KEY=your_sendgrid_api_key
# VITE_FROM_EMAIL=noreply@your-domain.com

# Optional: File Storage (for image uploads)
# VITE_AWS_ACCESS_KEY_ID=your_aws_access_key
# VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# VITE_AWS_REGION=us-east-1
# VITE_AWS_S3_BUCKET=your-s3-bucket-name

# Security Configuration
# VITE_JWT_SECRET=your_jwt_secret_here
# VITE_ENCRYPTION_KEY=your_encryption_key_here

# Rate Limiting Configuration
VITE_RATE_LIMIT_REQUESTS_PER_MINUTE=60
VITE_RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Cache Configuration
VITE_CACHE_TTL_SECONDS=300
VITE_REDIS_URL=redis://localhost:6379

# Database Configuration (for direct connections if needed)
# DATABASE_URL=postgresql://username:password@localhost:5432/adape_db

# Webhook Configuration (for platform callbacks)
VITE_WEBHOOK_SECRET=your_webhook_secret_here

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REMIXING=true
VITE_ENABLE_SCHEDULING=true
VITE_ENABLE_BATCH_POSTING=true
